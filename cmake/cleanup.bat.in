@echo off
REM 清理脚本 - 由 CMake 自动生成 (Windows 版本)
REM 构建目录: @CMAKE_BINARY_DIR@

REM 设置代码页为 UTF-8 以支持中文显示
chcp 65001 >nul 2>&1

echo 正在清理构建目录: @CMAKE_BINARY_DIR@
echo 警告: 这将删除所有构建文件!

REM 删除构建目录
if exist "@CMAKE_BINARY_DIR@" (
    rmdir /s /q "@CMAKE_BINARY_DIR@"
    echo 清理完成!
) else (
    echo 构建目录不存在，无需清理。
)

