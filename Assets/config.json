{
  "window": {
    "title": "SunnyLand",
    "width": 1280,
    "height": 720,
    "resizable": true
  },

  "graphics": {
    "vsync": false,
    "frame_rate": 144
  },

  "audio": {
    "sound_volume": 1.0,
    "music_volume": 1.0
  },

  "input_mapping": {
    "pause": ["p", "escape"],
    "move_up": ["w", "ArrowUp"],
    "move_down": ["s", "ArrowDown"],
    "move_left": ["a", "ArrowLeft"],
    "move_right": ["d", "ArrowRight"],
    "jump": ["j", "space"],
    "attack": ["k", "5", "MouseLeft"],
    "interact": ["e"],
    "fullscreen": ["f11"]
  }
}
